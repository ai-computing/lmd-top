# Site-specific values for lmd-top. Copy to cluster.local.env (untracked, see .gitignore),
# fill in the real values and export them before running lmd-top:
#   set -a; . ./cluster.local.env; set +a; lmd-top
# lmd-top reads these from the environment (src/config.rs). Unset values fall back to
# ~/.config/lmd-top/lmd-top.yaml, then to localhost defaults; no cluster address is built in.

# Prometheus host:port, plain HTTP (NodePort or a kubectl port-forward)
LMD_PROM=<prometheus-host>:30090

# Namespace holding the model servers, EPP and InferencePools
LMD_NS=llm-serving

# Grafana base URL used for dashboard links
LMD_GRAFANA=http://<grafana-host>:<port>

# Namespace of the ai-rm ConfigMap airm-placement (read-only placement decisions)
LMD_AIRM_NS=llm-d

# RBLN hostPath fallback only: the node's `pip install --user` site-packages (leave unset if the
# vendor stack is installed system-wide or you use LMD_COMPILE_IMAGE_RBLN / LMD_RBLN_TOOLCHAIN)
# LMD_RBLN_HOST_SITE_PACKAGES=/home/<user>/.local/lib/python3.10/site-packages
